<div class="card mb-4">



  <div class="card-content">

    <div class="media">


      <div class="media-left">



      <figure class="image is-128x128">
        <% if customer.image.attached? %>
          <%= image_tag customer.image %>
        <% end %>
      </figure>
      </div>

      <div class="media-content">
        <p class="title is-4"><%= customer.full_name %></p>
        <p class="subtitle is-6"><%= customer.email_address %></p>
        <p class="subtitle is-8"><%= customer.phone_number %></p>
        

      </div>
    </div>

    <div class="content">
      <%= customer.notes %>
    </div>

    
  </div>
</div>
